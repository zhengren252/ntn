# ===================================================================
# NeuroTrade Nexus (NTN) - 环境变量配置文件
# ===================================================================

# Redis配置
REDIS_PASSWORD=ntn-ci-redis-password

# Grafana配置 (V2.0)
GRAFANA_PASSWORD=admin

# 通用配置
ENVIRONMENT=production
LOG_LEVEL=INFO

# TACoreService配置
TACORE_SERVICE_HOST=ntn-tacore-service
TACORE_SERVICE_PORT=5555

# API工厂配置
API_FORGE_HOST=ntn-api-forge
API_FORGE_PORT=8000

# 网络配置
ASTS_NETWORK_NAME=asts_network